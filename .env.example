# Local development. Compose overrides only database_url and the server bind address.
MEMORY_DATABASE_URL=postgresql+psycopg://memory:memory@localhost:5432/memory
MEMORY_HOST=127.0.0.1
MEMORY_PORT=8765

# Set a chat model and an embedding model before starting the worker.
# With Compose, use host.docker.internal instead of localhost for a host-side model server.
MEMORY_LLM_BASE_URL=http://host.docker.internal:11434/v1
MEMORY_LLM_API_KEY=
MEMORY_LLM_MODEL=
MEMORY_LLM_JSON_SCHEMA=true
MEMORY_LLM_TIMEOUT=90

MEMORY_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_DIMENSIONS=1024
# Enable only if your endpoint supports a dimensions request parameter.
MEMORY_EMBEDDING_SEND_DIMENSIONS=false
MEMORY_EMBEDDING_DOCUMENT_PREFIX=
MEMORY_EMBEDDING_QUERY_PREFIX=

# Optional provider using POST {base_url}/rerank and index/relevance_score results.
MEMORY_RERANKER_BASE_URL=
MEMORY_RERANKER_API_KEY=
MEMORY_RERANKER_MODEL=
MEMORY_RERANKER_TIMEOUT=3
